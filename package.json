{
  "name": "art-of-motion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "tsx scripts/split-locales.ts",
    "predev": "tsx scripts/split-locales.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/split-locales.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "tscheck": "tsc --noEmit",
    "check": "npm run tscheck && npm run lint",
    "format": "prettier --write .",
    "locales:split": "tsx scripts/split-locales.ts",
    "test:unit": "vitest",
    "test:e2e": "supabase db reset && playwright test",
    "test:e2e:ui": "supabase db reset && playwright test --ui",
    "types:generate": "supabase gen types typescript --project-id ofasewgyeurvywflhctd --schema public > src/types/database.types.ts && prettier --write src/types/database.types.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hookform/resolvers": "5.7.1",
    "@next/third-parties": "16.3.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.1",
    "@tanstack/react-table": "9.0.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "shadcn": "4.16.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.10.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "supabase": "2.111.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
